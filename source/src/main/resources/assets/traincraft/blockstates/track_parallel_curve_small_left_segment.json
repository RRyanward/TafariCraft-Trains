{
  "multipart": [
    {
      "when": {
        "assembly_part": "0",
        "facing": "north"
      },
      "apply": {
        "model": "traincraft:block/batch/track_parallel_curve_small_left"
      }
    },
    {
      "when": {
        "assembly_part": "0",
        "facing": "east"
      },
      "apply": {
        "model": "traincraft:block/batch/track_parallel_curve_small_left",
        "y": 90
      }
    },
    {
      "when": {
        "assembly_part": "0",
        "facing": "south"
      },
      "apply": {
        "model": "traincraft:block/batch/track_parallel_curve_small_left",
        "y": 180
      }
    },
    {
      "when": {
        "assembly_part": "0",
        "facing": "west"
      },
      "apply": {
        "model": "traincraft:block/batch/track_parallel_curve_small_left",
        "y": 270
      }
    }
  ]
}
