    /**
     * Pulls the next stored furnace-fuel stack for a coupled locomotive. The
     * locomotive owns burn timing; the tender only owns reserve storage.
     */
    // Step 7.3.4-r3 - one fuel item per locomotive request.
    public ItemStack extractFuelStackForLocomotive() {
        if (this.level().isClientSide) {
            return ItemStack.EMPTY;
        }
        for (int slot = 0; slot < FUEL_INVENTORY_SIZE; slot++) {
            ItemStack stack = this.fuelInventory.getStackInSlot(slot);
            if (isFuel(stack)) {
                return this.fuelInventory.extractItem(slot, 1, false);
            }
        }
        return ItemStack.EMPTY;
    }

    /** Drains up to maxAmountMb of tender water for the coupled locomotive. */
    public int drainWaterForLocomotive(int maxAmountMb) {
        if (this.level().isClientSide || maxAmountMb <= 0 || this.waterAmount <= 0) {
            return 0;
        }
        int drained = Math.min(this.waterAmount, maxAmountMb);
        this.waterAmount -= drained;
        return drained;
    }

    private int getStoredFuelItemCount() {
        int total = 0;
        for (int slot = 0; slot < FUEL_INVENTORY_SIZE; slot++) {
            total += this.fuelInventory.getStackInSlot(slot).getCount();
        }
        return total;
    }

    private static boolean isFuel(ItemStack stack) {
        return !stack.isEmpty() && ForgeHooks.getBurnTime(stack, RecipeType.SMELTING) > 0;
    }

    /**
     * Called by the server coupling manager when this tender becomes a follower.
     * A tender placed backwards is snapped to the classic model polarity on its
     * own rail immediately when the connector establishes the link.  This is
     * visual/orientation state only; no locomotive/tender supply logic changes.
     */
    public void alignFacingToCouplingLeader(Entity leader) {
        float consistYaw;
        if (leader instanceof SmallSteamLocomotive locomotive) {
            consistYaw = locomotive.getTrainFacingYaw();
        } else if (leader instanceof SteamTender tender) {
            SmallSteamLocomotive locomotive = CouplingManager.findLeadLocomotive(leader);
            consistYaw = locomotive != null
                    ? locomotive.getTrainFacingYaw()
                    : tender.getTrainFacingYaw();
        } else {
            consistYaw = leader.getYRot();
        }

        float desiredYaw = this.getClassicTenderFacingFromLeader(
                leader, Mth.wrapDegrees(consistYaw));
        this.trainFacingYaw = desiredYaw;
        this.trainFacingInitialized = true;
        this.travelDirectionSign = 1;
        this.chainedPathDirection = Vec3.ZERO;
        this.chainedCurveHandoffTicks = 0;
        this.visualFacingYaw = desiredYaw;
        this.previousVisualFacingYaw = desiredYaw;
        this.visualFacingInitialized = true;
        this.setYRot(desiredYaw);
        this.yRotO = desiredYaw;
        this.syncTrainFacingYaw();
    }

