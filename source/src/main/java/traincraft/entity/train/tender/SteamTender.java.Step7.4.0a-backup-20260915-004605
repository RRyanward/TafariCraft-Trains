    private static double horizontalSpeedBlocksPerTick(Vec3 motion) {
        return Math.sqrt(motion.x * motion.x + motion.z * motion.z);
    }

    private static BlockPos getRailPosFor(Entity entity) {
        BlockPos railPos = entity.blockPosition();
        BlockState state = entity.level().getBlockState(railPos);
        if (!BaseRailBlock.isRail(state)) {
            BlockPos below = railPos.below();
            BlockState belowState = entity.level().getBlockState(below);
            if (BaseRailBlock.isRail(belowState)) {
                railPos = below;
            }
        }
        return railPos;
    }


    /**
     * Step 7.3.2e hard safety supervisor for chained rail movement.
     *
     * The normal controller may use the lead locomotive as feed-forward so a
     * long consist does not lose a little speed at every car. The movement
     * recorder exposed the dangerous edge case: if an IMMEDIATE leader slows or
     * stops on a hill/curve, the following car can still be carrying locomotive
     * speed and physically run through it.
     *
     * This supervisor never changes coupling topology and never moves a car off
     * Minecraft's rail tangent. It only bounds follower speed against the
     * immediate leader and the model-aware spacing band.
     */
    private void applyImmediateLeaderSpacingSafety(Entity leader) {
        if (!(leader instanceof SteamTender)) {
            return;
        }

        Vec3 motion = this.getDeltaMovement();
        Vec3 leaderMotion = leader.getDeltaMovement();

        double currentSpeed = Math.sqrt(
                motion.x * motion.x + motion.z * motion.z);
        double leaderSpeed = Math.sqrt(
                leaderMotion.x * leaderMotion.x + leaderMotion.z * leaderMotion.z);
        double distance = this.position().distanceTo(leader.position());

        boolean cornerHandoff = leader instanceof SteamTender leaderTender
                && (this.isChainedCornerTransition(leaderTender)
                || this.chainedCurveHandoffTicks > 0);

        double nearDistance = cornerHandoff
                ? this.getChainedCurveNearDistance(leader)
                : this.getChainedNearDistance(leader);
        double farDistance = cornerHandoff
                ? this.getChainedCurveFarDistance(leader)
                : this.getChainedFarDistance(leader);

        boolean reverseDrive = this.isConsistReverseDriveRequested(leader);
        double desiredSpeed = leaderSpeed;

        if (distance > farDistance) {
            double correction = Math.min(
                    CHAINED_HANDOFF_MAX_SPEED_BOOST,
                    (distance - farDistance) * CHAINED_HANDOFF_GAP_SPEED_GAIN);
            desiredSpeed += reverseDrive ? -correction : correction;
        } else if (distance < nearDistance) {
            double correction = Math.min(
                    CHAINED_HANDOFF_MAX_SPEED_BOOST,
                    (nearDistance - distance) * CHAINED_HANDOFF_GAP_SPEED_GAIN);
            desiredSpeed += reverseDrive ? correction : -correction;
        }

        desiredSpeed = Mth.clamp(
                desiredSpeed,
                0.0D,
                this.getChainedMaxCatchupSpeed(leader));

        boolean intervene = false;
        double safeSpeed = currentSpeed;

        if (!reverseDrive) {
            /*
             * Forward: compressed cars must stop driving through the car ahead.
             * A stretched car may catch up, but it may not run faster than the
             * spacing controller's immediate-leader target.
             */
            if (distance < nearDistance && currentSpeed > desiredSpeed) {
                safeSpeed = desiredSpeed;
                intervene = true;
            } else if (distance > farDistance && currentSpeed > desiredSpeed) {
                safeSpeed = desiredSpeed;
                intervene = true;
            } else if (distance >= nearDistance && distance <= farDistance
                    && currentSpeed > leaderSpeed + 0.08D) {
                safeSpeed = leaderSpeed + 0.08D;
                intervene = true;
            }
        } else {
            /*
             * Reverse: the follower is physically ahead of its leader. A
             * compressed segment must clear away from the pushing leader now;
             * a stretched segment must stop outrunning that leader.
             */
            RailShape reverseSafetyRailShape = this.getCurrentRailShape();
            RailShape reverseSafetyLeaderRailShape = getRailShapeFor(leader);
            SmallSteamLocomotive reverseSafetyLead =
                    CouplingManager.findLeadLocomotive(leader);
            boolean reverseSafetyInput = reverseSafetyLead != null
                    && reverseSafetyLead.isReverseDriveRequested();
            boolean reverseSafetyFollowerAscending =
                    reverseSafetyRailShape == RailShape.ASCENDING_NORTH
                            || reverseSafetyRailShape == RailShape.ASCENDING_SOUTH
                            || reverseSafetyRailShape == RailShape.ASCENDING_EAST
                            || reverseSafetyRailShape == RailShape.ASCENDING_WEST;
            boolean reverseSafetyLeaderAscending =
                    reverseSafetyLeaderRailShape == RailShape.ASCENDING_NORTH
                            || reverseSafetyLeaderRailShape == RailShape.ASCENDING_SOUTH
                            || reverseSafetyLeaderRailShape == RailShape.ASCENDING_EAST
                            || reverseSafetyLeaderRailShape == RailShape.ASCENDING_WEST;
            boolean reverseGradeHandoff =
                    reverseSafetyInput
                            && cornerHandoff
                            && (reverseSafetyFollowerAscending || reverseSafetyLeaderAscending);
            double reverseSafetyFarDistance = farDistance
                    + (reverseGradeHandoff
                            ? REVERSE_GRADE_HANDOFF_FAR_TOLERANCE
                            : 0.0D);

            if (distance < nearDistance && currentSpeed < desiredSpeed) {
                safeSpeed = desiredSpeed;
                intervene = true;
            } else if (distance > reverseSafetyFarDistance && currentSpeed > desiredSpeed) {
                safeSpeed = desiredSpeed;
                intervene = true;
            }
        }

        if (!intervene) {
            return;
        }

        Vec3 consistReferenceMotion = this.getConsistReferenceMotion(
                leader, leaderMotion);
        Vec3 directedTangent = this.getDirectedRailPathTangent(
                leader, motion, consistReferenceMotion);
        if (directedTangent == null) {
            return;
        }

        safeSpeed = Mth.clamp(
                safeSpeed,
                0.0D,
                this.getChainedMaxCatchupSpeed(leader));

        /*
         * Step 7.3.2f - Reverse uphill anti-stall.
         *
         * Do not let the post-move spacing safety recursively starve a
         * reverse-pushed car that is already climbing and sitting at roughly
         * correct coupler spacing. The floor is allowed only while the lead
         * locomotive is actively requesting reverse, only on ascending rail,
         * only outside curve handoff, and only inside a narrow near/far
         * spacing envelope. Compressed or genuinely stretched segments still
         * use the normal safety controller unchanged.
         */
        RailShape reverseUphillRailShape = this.getCurrentRailShape();
        boolean reverseUphillAscending =
                reverseUphillRailShape == RailShape.ASCENDING_NORTH
                        || reverseUphillRailShape == RailShape.ASCENDING_SOUTH
                        || reverseUphillRailShape == RailShape.ASCENDING_EAST
                        || reverseUphillRailShape == RailShape.ASCENDING_WEST;
        SmallSteamLocomotive reverseUphillLead =
                CouplingManager.findLeadLocomotive(leader);
        boolean reverseUphillInput = reverseUphillLead != null
                && reverseUphillLead.isReverseDriveRequested();
        boolean reverseUphillSpacingWindow =
                distance >= nearDistance - 0.040D
                        && distance <= farDistance + 0.040D;

        if (reverseDrive
                && reverseUphillInput
                && !cornerHandoff
                && reverseUphillAscending
                && reverseUphillSpacingWindow
                && safeSpeed < CHAINED_REVERSE_UPHILL_MIN_PUSH_SPEED) {
            safeSpeed = Math.min(
                    CHAINED_REVERSE_UPHILL_MIN_PUSH_SPEED,
                    this.getChainedMaxCatchupSpeed(leader));
        }

        this.setDeltaMovement(
                directedTangent.x * safeSpeed,
                motion.y,
                directedTangent.z * safeSpeed);

        /*
         * Keep a compact intervention trace in the existing dedicated coupler
         * log. The 7.3.2d flight recorder can still be used unchanged.
         */
        if ((this.tickCount & 1) == 0) {
            String line = String.format(java.util.Locale.ROOT,
                    "[TC-SPACING-SAFETY] gameTick=%d entityTick=%d id=%d type=%s leader=%s#%d reverse=%s "
                            + "distance=%.3f near=%.3f far=%.3f current=%.3f leaderSpeed=%.3f safe=%.3f "
                            + "rail=%s leaderRail=%s",
                    this.level().getGameTime(), this.tickCount, this.getId(),
                    this.getClass().getSimpleName(),
                    leader.getClass().getSimpleName(), leader.getId(),
                    reverseDrive,
                    distance, nearDistance, farDistance,
                    currentSpeed, leaderSpeed, safeSpeed,
                    this.getCurrentRailShape(), getRailShapeFor(leader));
            COUPLER_DEBUG_LOG.info(line);
            try {
                Files.writeString(
                        COUPLER_DEBUG_FILE,
                        line + System.lineSeparator(),
                        StandardCharsets.UTF_8,
                        StandardOpenOption.CREATE,
                        StandardOpenOption.WRITE,
                        StandardOpenOption.APPEND);
            } catch (IOException exception) {
                COUPLER_DEBUG_LOG.error(
                        "[TC-SPACING-SAFETY] Failed to write {}",
                        COUPLER_DEBUG_FILE,
                        exception);
            }
        }
    }
    /**
     * Step 7.2.1k diagnostic telemetry.  Logged after vanilla minecart movement
     * and the post-move catch-up so the numbers represent the spacing the player
     * actually sees.  No state is changed here.
     */
    private void logCouplerTelemetry() {
        if ((this.tickCount % COUPLER_DEBUG_INTERVAL_TICKS) != 0) {
            return;
        }

        Entity leader = this.getPrimaryCouplingLeader();
        if (leader == null) {
            return;
        }

        Vec3 offset = leader.position().subtract(this.position());
        double centerDistance = offset.length();
        double horizontalDistance = Math.sqrt(offset.x * offset.x + offset.z * offset.z);
        double verticalDelta = leader.getY() - this.getY();

        boolean chained = leader instanceof SteamTender;
        double touchCenterDistance = this.getCouplerTouchTargetDistance(leader);
        // On ascending rails the model rotates with the track, so the coupler
        // reach is along the 3D rail path, not only the horizontal projection.
        double estimatedNubGap = centerDistance - touchCenterDistance;

        Vec3 axis = this.getCurrentRailHorizontalAxis();
        double leaderAlongAxis = Double.NaN;
        double motionAlongAxis = Double.NaN;
        String axisText = "none";
        if (axis != null) {
            leaderAlongAxis = offset.x * axis.x + offset.z * axis.z;
            Vec3 motion = this.getDeltaMovement();
            motionAlongAxis = motion.x * axis.x + motion.z * axis.z;
            axisText = String.format(java.util.Locale.ROOT, "%.3f,%.3f", axis.x, axis.z);
        }

        Vec3 followerMotion = this.getDeltaMovement();
        Vec3 leaderMotion = leader.getDeltaMovement();
        double followerKmh = horizontalSpeedKmh(followerMotion);
        double leaderKmh = horizontalSpeedKmh(leaderMotion);
        SmallSteamLocomotive leadLocomotive = CouplingManager.findLeadLocomotive(leader);
        double leadKmh = leadLocomotive != null
                ? horizontalSpeedKmh(leadLocomotive.getDeltaMovement())
                : leaderKmh;

        RailShape followerShape = this.getCurrentRailShape();
        RailShape leaderShape = getRailShapeFor(leader);
        String role = chained ? "CHAINED" : "PRIMARY";

        String line = String.format(java.util.Locale.ROOT,
                "[TC-COUPLER] gameTick=%d entityTick=%d tender=%d role=%s leader=%s#%d center=%.3f horiz=%.3f dy=%.3f nubGap=%.3f touchTarget=%.3f "
                        + "speed=%.2f leaderSpeed=%.2f leadSpeed=%.2f rail=%s leaderRail=%s axis=(%s) leaderAlong=%.3f motionAlong=%.3f "
                        + "handoff=%d pos=(%.3f,%.3f,%.3f) leaderPos=(%.3f,%.3f,%.3f)",
                this.level().getGameTime(), this.tickCount,
                this.getId(), role, leader.getClass().getSimpleName(), leader.getId(),
                centerDistance, horizontalDistance, verticalDelta, estimatedNubGap, touchCenterDistance,
                followerKmh, leaderKmh, leadKmh,
                followerShape, leaderShape, axisText, leaderAlongAxis, motionAlongAxis,
                this.chainedCurveHandoffTicks,
                this.getX(), this.getY(), this.getZ(),
                leader.getX(), leader.getY(), leader.getZ());
        // Keep the normal Forge log line, but also write a dedicated file so the
        // diagnostic survives any logger/category filtering in the dev client.
        COUPLER_DEBUG_LOG.info(line);
        try {
            Files.writeString(COUPLER_DEBUG_FILE, line + System.lineSeparator(),
                    StandardCharsets.UTF_8,
                    StandardOpenOption.CREATE,
                    StandardOpenOption.WRITE,
                    StandardOpenOption.APPEND);
        } catch (IOException exception) {
            COUPLER_DEBUG_LOG.error("[TC-COUPLER] Failed to write {}", COUPLER_DEBUG_FILE, exception);
        }
    }

    private static double horizontalSpeedKmh(Vec3 motion) {
        double blocksPerTick = Math.sqrt(motion.x * motion.x + motion.z * motion.z);
        return blocksPerTick * 20.0D * 3.6D;
    }

    @Nullable
    private static RailShape getRailShapeFor(Entity entity) {
        if (!(entity instanceof Minecart minecart)) {
            return null;
        }

        BlockPos railPos = entity.blockPosition();
        BlockState state = entity.level().getBlockState(railPos);
        if (!BaseRailBlock.isRail(state)) {
            railPos = railPos.below();
            state = entity.level().getBlockState(railPos);
        }
        if (!BaseRailBlock.isRail(state)) {
            return null;
        }

        BaseRailBlock rail = (BaseRailBlock) state.getBlock();
        return rail.getRailDirection(state, entity.level(), railPos, minecart);
    }

    /**
     * For the first tender, preserve the original immediate-locomotive reference.
     * For a chained follower, use the lead locomotive as the speed reference so
     * small losses are not compounded once per car.
     */
    private Vec3 getConsistReferenceMotion(Entity leader, Vec3 fallback) {
        if (leader instanceof SteamTender) {
            SmallSteamLocomotive locomotive = CouplingManager.findLeadLocomotive(leader);
            if (locomotive != null && !locomotive.isRemoved()) {
                return locomotive.getDeltaMovement();
            }
        }
        return fallback;
    }

    /**
     * True when the lead locomotive is actively commanding reverse.  Coupling
     * topology stays locomotive -> rear cars even when physical travel reverses,
     * so chained gap control must invert its speed response while the consist is
     * being pushed.
     */
    private boolean isConsistReverseDriveRequested(Entity leader) {
        SmallSteamLocomotive locomotive = leader instanceof SmallSteamLocomotive direct
                ? direct
                : CouplingManager.findLeadLocomotive(leader);
        return locomotive != null
                && !locomotive.isRemoved()
                && locomotive.isReverseConsistTravel();
    }

    /**
     * Returns an undirected local horizontal tangent to Minecraft's actual
     * minecart path.  getPosOffs() follows the rail geometry across block
     * boundaries, so a 90-degree rail is no longer represented by a fixed
     * diagonal vector that points through the inside of the corner.
     */
    @Nullable
    private Vec3 getCurrentRailHorizontalAxis() {
        Vec3 forward = this.getPosOffs(
                this.getX(), this.getY(), this.getZ(), 0.25D);
        Vec3 backward = this.getPosOffs(
                this.getX(), this.getY(), this.getZ(), -0.25D);
        if (forward != null && backward != null) {
            double dx = forward.x - backward.x;
            double dz = forward.z - backward.z;
            double length = Math.sqrt(dx * dx + dz * dz);
            if (length > 1.0E-5D) {
                return new Vec3(dx / length, 0.0D, dz / length);
            }
        }

        // Fallback for the rare tick where path sampling cannot resolve both
        // sides of the cart.  Straight/slope rails are exact here; the curved
        // fallback is used only until getPosOffs() becomes available again.
        RailShape shape = this.getCurrentRailShape();
        if (shape == null) {
            return null;
        }

        double diagonal = 1.0D / Math.sqrt(2.0D);
        return switch (shape) {
            case NORTH_SOUTH, ASCENDING_NORTH, ASCENDING_SOUTH -> new Vec3(0.0D, 0.0D, 1.0D);
            case EAST_WEST, ASCENDING_EAST, ASCENDING_WEST -> new Vec3(1.0D, 0.0D, 0.0D);
            case SOUTH_EAST, NORTH_WEST -> new Vec3(diagonal, 0.0D, diagonal);
            case NORTH_EAST, SOUTH_WEST -> new Vec3(diagonal, 0.0D, -diagonal);
        };
    }

    /**
     * True while two chained tenders are negotiating the same corner handoff.
     * Checking axis disagreement as well as the literal curved-rail shape covers
     * the brief case where the leader has already left the curve and the follower
     * has not reached it yet (or vice versa).
     */
    private boolean isChainedCornerTransition(SteamTender leader) {
        if (this.isOnSharpCurve() || leader.isOnSharpCurve()) {
            return true;
        }

        Vec3 followerAxis = this.getCurrentRailHorizontalAxis();
        Vec3 leaderAxis = leader.getCurrentRailHorizontalAxis();
        if (followerAxis == null || leaderAxis == null) {
            return false;
        }

        double axisDot = Math.abs(
                followerAxis.x * leaderAxis.x + followerAxis.z * leaderAxis.z);
        return axisDot < 0.85D;
    }

    @Nullable
    private Entity getPrimaryCouplingLeader() {
        Entity linked = CouplingManager.resolve(this, this);
        if (linked == null || linked.isRemoved()) {
            return null;
        }
        return linked instanceof SmallSteamLocomotive || linked instanceof SteamTender
                ? linked
                : null;
    }

    private static boolean isRollingStockOnSharpCurve(Entity entity) {
        if (entity instanceof SmallSteamLocomotive locomotive) {
            return locomotive.isOnSharpCurve();
        }
        if (entity instanceof SteamTender tender) {
            return tender.isOnSharpCurve();
        }
        return false;
    }

    /**
     * True only when the follower, its immediate leader and the lead locomotive
     * are all essentially stopped.  This is intentionally stricter than merely
     * checking the handbrake so a crawling or coasting consist never receives a
     * position snap.  Sharp curves keep the proven rail-path spacing logic.
     */
    private boolean shouldHardSettleStationaryCoupling(Entity leader) {
        /*
         * Step 7.3.2m - active reverse must never hard-settle.
         *
         * Step 7.2.1m's stationary spacing snap is correct only when the consist
         * is genuinely resting. The 7.3.2l-r1 recorder proved that a powered
         * reverse consist can crawl below the 0.003 b/t stationary threshold at
         * a hill/curve exit. The old helper then snapped spacing, zeroed motion,
         * returned before the primary controller, and repeatedly deadlocked the
         * pushed consist even though the driver was still holding reverse.
         *
         * A live reverse command is therefore authoritative: allow normal rail
         * movement/controller logic to wake and push the consist. Once reverse
         * is released, the original stationary settle behavior is unchanged.
         */
        SmallSteamLocomotive commandedLead =
                leader instanceof SmallSteamLocomotive directLeader
                        ? directLeader
                        : CouplingManager.findLeadLocomotive(leader);

        if (commandedLead != null && commandedLead.isReverseDriveRequested()) {
            return false;
        }
        if (this.isOnSharpCurve() || isRollingStockOnSharpCurve(leader)) {
            return false;
        }

        if (horizontalSpeedBlocksPerTick(this.getDeltaMovement())
                > STATIONARY_COUPLER_SETTLE_SPEED_THRESHOLD) {
            return false;
        }
        if (horizontalSpeedBlocksPerTick(leader.getDeltaMovement())
                > STATIONARY_COUPLER_SETTLE_SPEED_THRESHOLD) {
            return false;
        }

        SmallSteamLocomotive locomotive = CouplingManager.findLeadLocomotive(leader);
        return locomotive == null
                || horizontalSpeedBlocksPerTick(locomotive.getDeltaMovement())
                <= STATIONARY_COUPLER_SETTLE_SPEED_THRESHOLD;
    }


    /**
     * Vanilla minecart motion is resolved independently for each vehicle. On a
     * descending rail or the first tick of a curve that can consume part of the
     * tender's commanded speed after the pre-move coupling constraint has already
     * run. Reinforce the follower velocity after movement so the next tick starts
     * with enough speed to close the couplers instead of letting the gap compound.
     */
    private void applyPostMoveCouplingCatchup() {
        Entity leader = this.getPrimaryCouplingLeader();
        if (leader == null) {
            return;
        }

        if (CouplingManager.isTrainHandBrakeApplied(leader)) {
            this.setDeltaMovement(Vec3.ZERO);
            return;
        }

        Vec3 offset = leader.position().subtract(this.position());
        double distance = offset.length();
        boolean curveTransition = this.isOnSharpCurve() || isRollingStockOnSharpCurve(leader);
        boolean chainedFollower = leader instanceof SteamTender;
        boolean chainedCornerTransition = chainedFollower
                && this.isChainedCornerTransition((SteamTender) leader);
        if (chainedFollower) {
            // Chained cars are always rail-path controlled now. Re-apply the same
            // bounded speed/gap hold after vanilla resolves the cart onto the rail.
            Vec3 consistReferenceMotion = this.getConsistReferenceMotion(
                    leader, leader.getDeltaMovement());
            this.debugControllerPhase = "POST";
            this.applyChainedRailPathSpeed(
                    leader, this.getDeltaMovement(), consistReferenceMotion, distance);
                    this.applyImmediateLeaderSpacingSafety(leader);
            return;
        }

        double postMoveGapThreshold = curveTransition
                ? this.getPrimaryCurvePostMoveGapThreshold(leader)
                : this.getPrimaryPostMoveGapThreshold(leader);
        if (distance <= postMoveGapThreshold || distance < 1.0E-5D) {
            return;
        }

        Vec3 motion = this.getDeltaMovement();
        double horizontalSpeed = Math.sqrt(motion.x * motion.x + motion.z * motion.z);
        double axisX;
        double axisZ;
        Vec3 chainedRailAxis = leader instanceof SteamTender ? this.getCurrentRailHorizontalAxis() : null;
        if (chainedRailAxis != null) {
            axisX = chainedRailAxis.x;
            axisZ = chainedRailAxis.z;
        } else if (horizontalSpeed > 1.0E-4D) {
            axisX = motion.x / horizontalSpeed;
            axisZ = motion.z / horizontalSpeed;
        } else {
            Vec3 leaderMotion = leader.getDeltaMovement();
            double leaderHorizontalSpeed = Math.sqrt(
                    leaderMotion.x * leaderMotion.x + leaderMotion.z * leaderMotion.z);
            if (leaderHorizontalSpeed > 1.0E-4D) {
                axisX = leaderMotion.x / leaderHorizontalSpeed;
                axisZ = leaderMotion.z / leaderHorizontalSpeed;
            } else {
                double radians = Math.toRadians(this.getTrainFacingYaw());
                axisX = Math.sin(radians);
                axisZ = -Math.cos(radians);
            }
        }

        double towardDot = offset.x * axisX + offset.z * axisZ;
        double towardSign = towardDot >= 0.0D ? 1.0D : -1.0D;
        Vec3 consistReferenceMotion = this.getConsistReferenceMotion(leader, leader.getDeltaMovement());
        double leaderSpeed = Math.max(leader.getDeltaMovement().length(), consistReferenceMotion.length());
        double requestedCatchup = leaderSpeed
                + (distance - postMoveGapThreshold) * POST_MOVE_CATCHUP_PER_BLOCK;

        RailShape shape = this.getCurrentRailShape();
        double cap = isSharpVanillaCurve(shape)
                ? COUPLED_CURVE_CATCHUP_SPEED
                : COUPLED_STRAIGHT_CATCHUP_SPEED;
        double catchupSpeed = Mth.clamp(requestedCatchup, 0.0D, cap);

        double currentAlongRail = motion.x * axisX + motion.z * axisZ;
        double desiredAlongRail = towardSign * catchupSpeed;
        if (Math.signum(desiredAlongRail) != Math.signum(currentAlongRail)
                || Math.abs(desiredAlongRail) > Math.abs(currentAlongRail)) {
            this.setDeltaMovement(axisX * desiredAlongRail, motion.y, axisZ * desiredAlongRail);
        }
    }

    @Override
    public InteractionResult interact(Player player, InteractionHand hand) {
        ItemStack held = player.getItemInHand(hand);
        if (held.getItem() instanceof ConnectorItem) {
            return ConnectorItem.handleRollingStockClick(this, player, hand);
        }

        if (!this.level().isClientSide && player instanceof ServerPlayer serverPlayer) {
            NetworkHooks.openScreen(serverPlayer, this,
                    buffer -> buffer.writeInt(this.getId()));
        }
        return InteractionResult.sidedSuccess(this.level().isClientSide);
    }

    @Override
    public Component getDisplayName() {
        return Component.literal("Tender");
    }

    @Nullable
    @Override
    public AbstractContainerMenu createMenu(int containerId, Inventory inventory, Player player) {
        return new TenderMenu(containerId, inventory, this);
    }

    /**
     * The original tender uses a dedicated liquid-container slot. For the first
     * classic GUI pass, a water bucket placed in that slot transfers 1000 mB to
     * the tender and leaves the empty bucket in the same slot. A full tank leaves
     * the water bucket untouched instead of consuming it.
     */
    private void processWaterContainerInput() {
        ItemStack stack = this.waterContainerInventory.getStackInSlot(0);
        if (!stack.is(Items.WATER_BUCKET)
                || this.waterAmount > WATER_CAPACITY_MB - WATER_BUCKET_MB) {
            return;
        }

        this.waterAmount += WATER_BUCKET_MB;

        // Match the locomotive: return empty buckets into reserve storage first
        // so vanilla buckets can stack there. If all 15 storage slots are full,
        // keep the returned bucket in the dedicated liquid-container slot.
        int bucketOutputSlot = this.findEmptyBucketOutputSlot();
        if (bucketOutputSlot >= 0) {
            this.waterContainerInventory.setStackInSlot(0, ItemStack.EMPTY);
            this.fuelInventory.insertItem(
                    bucketOutputSlot, new ItemStack(Items.BUCKET), false);
        } else {
            this.waterContainerInventory.setStackInSlot(0, new ItemStack(Items.BUCKET));
        }
    }

    private int findEmptyBucketOutputSlot() {
        ItemStack emptyBucket = new ItemStack(Items.BUCKET);
        for (int slot = 0; slot < FUEL_INVENTORY_SIZE; slot++) {
            ItemStack remainder = this.fuelInventory.insertItem(slot, emptyBucket, true);
            if (remainder.isEmpty()) {
                return slot;
            }
        }
        return -1;
    }

    @Override
    public void push(Entity entity) {
        if (this.isCoupledTo(entity.getUUID())) {
            return;
        }
        super.push(entity);
    }

    @Override
    public boolean hurt(DamageSource damageSource, float amount) {
        Entity attacker = damageSource.getEntity();
        // Vanilla creative minecart removal can discard the entity from inside
        // super.hurt(). Unlink first so the surviving locomotive never keeps a
        // stale tender UUID.
        if (!this.level().isClientSide
                && attacker instanceof Player creativePlayer
                && creativePlayer.getAbilities().instabuild) {
            CouplingManager.unlinkAll(this, this);
        }

        boolean handled = super.hurt(damageSource, amount);
        if (!handled || this.level().isClientSide || this.isRemoved()) {
            return handled;
        }

        if (!(attacker instanceof Player player) || player.getAbilities().instabuild) {
            return handled;
        }

        if (this.tickCount - this.lastSurvivalRemovalHitTick > SURVIVAL_REMOVAL_RESET_TICKS) {
            this.survivalRemovalHits = 0;
        }
        this.lastSurvivalRemovalHitTick = this.tickCount;
        this.survivalRemovalHits++;
        if (this.survivalRemovalHits >= SURVIVAL_REMOVAL_HITS) {
            this.destroy(damageSource);
        }
        return true;
    }

    @Override
    public void destroy(DamageSource damageSource) {
        CouplingManager.unlinkAll(this, this);
        this.dropTenderFuelInventory();
        super.destroy(damageSource);
    }

    /**
     * Final safety net for cart removal. Player damage normally reaches destroy(),
     * and creative removal is unlinked before vanilla hurt() can discard the cart,
     * but other permanent removal paths can bypass both callbacks. Only destructive
     * removals clear couplers; chunk unload/dimension lifecycle removal must preserve
     * saved train links.
     */
    @Override
    public void remove(Entity.RemovalReason reason) {
