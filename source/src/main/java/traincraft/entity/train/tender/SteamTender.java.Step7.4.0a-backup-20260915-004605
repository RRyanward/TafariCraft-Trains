    public double getCouplerTouchTargetDistance(Entity leader) {
        double leaderReach;
        if (leader instanceof SmallSteamLocomotive) {
            leaderReach = LOCO_REAR_NUB_REACH;
        } else if (leader instanceof SteamTender tenderLeader) {
            leaderReach = tenderLeader.getTrailingCouplerReach();
        } else {
            leaderReach = TENDER_TRAILING_NUB_REACH;
        }
        return leaderReach + this.getLeaderFacingCouplerReach();
    }

    private double getPrimaryTouchTargetDelta(Entity leader) {
        return this.getCouplerTouchTargetDistance(leader)
                - (LOCO_REAR_NUB_REACH + TENDER_LEADER_NUB_REACH);
    }

    private double getChainedTouchTargetDelta(Entity leader) {
        return this.getCouplerTouchTargetDistance(leader)
                - (TENDER_TRAILING_NUB_REACH + TENDER_LEADER_NUB_REACH);
