            return CURVE_MAX_SPEED_BLOCKS_PER_TICK;
        }
        return MAX_SPEED_BLOCKS_PER_TICK;
    }

    private static boolean isSharpVanillaCurve(@Nullable RailShape shape) {
        return shape == RailShape.NORTH_EAST
                || shape == RailShape.NORTH_WEST
                || shape == RailShape.SOUTH_EAST
                || shape == RailShape.SOUTH_WEST;
    }

    /**
     * Step 7.2.1h server-authoritative tender polarity.
     *
     * A coupled tender always knows which vehicle is physically in front of it:
     * its primary coupling leader.  Resolve the leader onto the tender's local
     * rail axis, then apply the classic model's fixed 180-degree polarity offset.
     * This remains true while driving forward, reversing, climbing or descending
     * because the physical order of the consist does not change.
     *
     * For an uncoupled tender, preserve the established front/back end by taking
     * the rail-facing candidate closest to its previous facing.
     */
    private void updateTrainFacingFromRail() {
        RailShape shape = this.getCurrentRailShape();
        if (shape == null) {
            return;
        }

        float previous = this.getTrainFacingYaw();
        Entity leader = this.getPrimaryCouplingLeader();

        if (leader != null) {
            this.trainFacingYaw = this.getClassicTenderFacingFromLeader(leader, previous);
        } else {
            this.trainFacingYaw = this.getRailFacingClosestTo(shape, previous);
        }

        this.trainFacingInitialized = true;
        this.setYRot(this.trainFacingYaw);
        this.yRotO = this.trainFacingYaw;
        this.syncTrainFacingYaw();
    }

    private void syncTrainFacingYaw() {
        if (!this.level().isClientSide) {
            float wrapped = Mth.wrapDegrees(this.trainFacingYaw);
            this.trainFacingYaw = wrapped;
            if (Math.abs(Mth.wrapDegrees(this.entityData.get(DATA_TRAIN_FACING_YAW) - wrapped)) > 0.01F) {
                this.entityData.set(DATA_TRAIN_FACING_YAW, wrapped);
            }
        }
    }

    private float getRailFacingClosestTo(RailShape shape, float referenceYaw) {
        float axisYaw = switch (shape) {
            case NORTH_SOUTH, ASCENDING_NORTH, ASCENDING_SOUTH -> 0.0F;
            case EAST_WEST, ASCENDING_EAST, ASCENDING_WEST -> 90.0F;
            case SOUTH_EAST, NORTH_WEST -> 45.0F;
            case NORTH_EAST, SOUTH_WEST -> -45.0F;
        };

        float first = Mth.wrapDegrees(axisYaw);
        float opposite = Mth.wrapDegrees(axisYaw + 180.0F);
        float firstDistance = Math.abs(Mth.wrapDegrees(first - referenceYaw));
        float oppositeDistance = Math.abs(Mth.wrapDegrees(opposite - referenceYaw));
        return firstDistance <= oppositeDistance ? first : opposite;
    }

    /**
     * Step 7.2.1i classic tender polarity.
     *
     * Step 7.2.1h correctly found the rail tangent end that points toward the
     * coupling leader, but the tender model's authored forward yaw is physically
     * the opposite end of the body.  That made every deterministic connector
     * correction land 180 degrees backwards.  Keep the same stable server-side
     * rail/leader decision, then invert it once for the model's real polarity.
     */
    private float getClassicTenderFacingFromLeader(Entity leader, float fallbackYaw) {
        RailShape shape = this.getCurrentRailShape();
        if (shape == null) {
            return Mth.wrapDegrees(fallbackYaw + 180.0F);
        }

        float first = this.getRailFacingClosestTo(shape, fallbackYaw);
        float opposite = Mth.wrapDegrees(first + 180.0F);
        Vec3 toLeader = leader.position().subtract(this.position());
        double horizontalLength = Math.sqrt(toLeader.x * toLeader.x + toLeader.z * toLeader.z);

        float towardLeaderYaw;
        if (horizontalLength < 1.0E-4D) {
            towardLeaderYaw = first;
        } else {
            double firstRadians = Math.toRadians(first);
            double oppositeRadians = Math.toRadians(opposite);
            double firstDot = Math.sin(firstRadians) * toLeader.x
                    + (-Math.cos(firstRadians)) * toLeader.z;
            double oppositeDot = Math.sin(oppositeRadians) * toLeader.x
                    + (-Math.cos(oppositeRadians)) * toLeader.z;

            // Around the exact center of a curve the leader vector can be nearly
            // perpendicular to the local tangent.  Preserve the stable fallback
            // side in that tiny tie case instead of allowing a random 180 flip.
            if (Math.abs(firstDot - oppositeDot) < horizontalLength * 0.05D) {
                towardLeaderYaw = first;
            } else {
                towardLeaderYaw = firstDot >= oppositeDot ? first : opposite;
            }
        }

        // The classic tender model's locomotive-facing coupling end is opposite
        // its authored forward yaw.  This is the single polarity correction.
        return Mth.wrapDegrees(towardLeaderYaw + 180.0F);
    }

    /** Render-only yaw smoothing; the rail physics still uses the exact shape. */
    private void updateVisualTrainFacing() {
        if (!this.visualFacingInitialized) {
            this.visualFacingYaw = this.getTrainFacingYaw();
            this.previousVisualFacingYaw = this.visualFacingYaw;
            this.visualFacingInitialized = true;
            return;
        }

        this.previousVisualFacingYaw = this.visualFacingYaw;
        float delta = Mth.wrapDegrees(this.getTrainFacingYaw() - this.visualFacingYaw);

        // A true 180-degree polarity change only happens when the connector has
        // corrected a backwards-placed tender (or when an old save is repaired).
        // Snap that once instead of visibly spinning the model for several ticks.
        if (Math.abs(delta) >= VISUAL_POLARITY_SNAP_DEGREES) {
            this.visualFacingYaw = this.getTrainFacingYaw();
            this.previousVisualFacingYaw = this.visualFacingYaw;
            return;
        }

        float step = Mth.clamp(delta,
                -VISUAL_FACING_MAX_TURN_DEGREES,
                VISUAL_FACING_MAX_TURN_DEGREES);
        this.visualFacingYaw = Mth.wrapDegrees(this.visualFacingYaw + step);
    }

    public float getRenderTrainFacingYaw(float partialTicks) {
        if (!this.visualFacingInitialized) {
            return this.getTrainFacingYaw();
        }
        return Mth.rotLerp(partialTicks, this.previousVisualFacingYaw, this.visualFacingYaw);
    }

