    private void dropTenderFuelInventory() {
        if (this.level().isClientSide || this.tenderInventoryDropped) {
            return;
        }

        this.tenderInventoryDropped = true;
        for (int slot = 0; slot < FUEL_INVENTORY_SIZE; slot++) {
            ItemStack stack = this.fuelInventory.getStackInSlot(slot);
            if (stack.isEmpty()) {
                continue;
            }
            ItemStack dropped = this.fuelInventory.extractItem(slot, stack.getCount(), false);
            if (!dropped.isEmpty()) {
                Containers.dropItemStack(
                        this.level(),
                        this.getX(), this.getY() + 0.35D, this.getZ(),
                        dropped);
            }
        }

        ItemStack waterContainer = this.waterContainerInventory.extractItem(
                0, this.waterContainerInventory.getStackInSlot(0).getCount(), false);
        if (!waterContainer.isEmpty()) {
            Containers.dropItemStack(
                    this.level(),
                    this.getX(), this.getY() + 0.35D, this.getZ(),
                    waterContainer);
        }
    }

    @Override
