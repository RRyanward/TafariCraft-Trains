    /**
     * Step 7.2.1l connector-time coupler-nub alignment.
     *
     * The telemetry gave us real straight-track center distances, and the classic
     * model geometry gives exact touch targets: 2.10 blocks for locomotive ->
     * tender and 2.05 blocks for tender -> tender.  Move only the follower and
     * only along Minecraft's rail path.  This works even when the handbrake is on,
     * which is why the old runtime spacing correction could not fix a stationary
     * freshly connected consist.
     */
    public void alignCouplerSpacingToLeader(Entity leader) {
        if (this.level().isClientSide || leader == null || leader.isRemoved()) {
            return;
        }

        double targetDistance = this.getCouplerTouchTargetDistance(leader);
        double currentDistance = this.position().distanceTo(leader.position());
        double currentError = Math.abs(currentDistance - targetDistance);
        if (currentError <= 0.025D) {
            return;
        }

        // Connector use is a setup action, not a towing teleport.  The measured
        // overlap is ~0.37-0.52 blocks, so cap one-time correction to 0.85 blocks.
        double correctionDistance = Math.min(0.85D, currentError + 0.08D);
        Vec3 best = this.position();
        double bestError = currentError;

        double[] scales = {1.0D, 0.75D, 0.50D, 0.25D};
        for (double sign : new double[]{-1.0D, 1.0D}) {
            for (double scale : scales) {
                Vec3 candidate = this.getPosOffs(
                        this.getX(), this.getY(), this.getZ(),
                        sign * correctionDistance * scale);
                if (candidate == null) {
                    continue;
                }
                double error = Math.abs(candidate.distanceTo(leader.position()) - targetDistance);
                if (error + 1.0E-4D < bestError) {
                    best = candidate;
                    bestError = error;
                }
            }
        }

        if (!best.equals(this.position()) && bestError < currentError) {
            this.setPos(best.x, best.y, best.z);
            this.setDeltaMovement(Vec3.ZERO);
            this.forceClientPositionSync();
        }
    }

    /**
     * A raw server-side setPos() can remain invisible to a stationary client-side
     * minecart until normal movement produces another tracking packet.  Send one
     * absolute entity teleport packet immediately so connector-time and stopped-
     * consist spacing corrections are visible without nudging the locomotive.
     */
    private void forceClientPositionSync() {
        if (this.level() instanceof ServerLevel serverLevel) {
            serverLevel.getChunkSource().broadcastAndSend(
                    this, new ClientboundTeleportEntityPacket(this));
        }
    }

