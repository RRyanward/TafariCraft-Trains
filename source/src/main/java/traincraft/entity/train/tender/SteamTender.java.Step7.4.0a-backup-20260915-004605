    @Override
    public void tick() {
        if (!this.trainFacingInitialized && !this.level().isClientSide) {
            this.trainFacingYaw = this.getYRot();
            this.trainFacingInitialized = true;
            this.syncTrainFacingYaw();
        }

        if (!this.level().isClientSide) {
            this.applyCouplingConstraint();
        }

        super.tick();

        if (!this.level().isClientSide) {
            this.applyPostMoveCouplingCatchup();
            this.logCouplerTelemetry();
            this.logMovementFlightRecorder();
            this.processWaterContainerInput();
        }

        if (this.level().isClientSide) {
            // Never guess tender polarity from client minecart motion.  The
            // connector and coupling topology live on the server, so mirror the
            // authoritative yaw here even when the consist is standing still.
            this.trainFacingYaw = this.entityData.get(DATA_TRAIN_FACING_YAW);
            this.trainFacingInitialized = true;
        } else {
            this.updateTrainFacingFromRail();
        }
        this.updateVisualTrainFacing();
    }

    private void applyCouplingConstraint() {
        Entity leader = this.getPrimaryCouplingLeader();
        if (leader == null) {
            return;
        }

        Vec3 offset = leader.position().subtract(this.position());
        double distance = offset.length();
        if (distance > COUPLING_BREAK_DISTANCE) {
            CouplingManager.unlink(this, this);
            SmallSteamLocomotive locomotive = CouplingManager.findLeadLocomotive(leader);
            if (locomotive != null && locomotive.getFirstPassenger() instanceof ServerPlayer driver) {
                driver.displayClientMessage(
                        net.minecraft.network.chat.Component.translatable("message.traincraft.connector.broken"),
                        true);
            }
            return;
        }

        /*
         * Step 7.2.1m: connector-time alignment was already correct on the server,
         * but a stopped minecart could remain visually compressed (or appear not
         * to snap at all) until the locomotive moved.  Once the entire consist is
         * truly stationary, restore the measured straight/hill coupler spacing by
         * position along Minecraft's rail path.  Never do this on a sharp 90-degree
         * curve, where Euclidean center distance is not the path distance.
         */
        if (this.shouldHardSettleStationaryCoupling(leader)) {
            this.alignCouplerSpacingToLeader(leader);
            this.setDeltaMovement(Vec3.ZERO);
            return;
        }

        if (CouplingManager.isTrainHandBrakeApplied(leader)) {
            this.setDeltaMovement(Vec3.ZERO);
            return;
        }

        if (distance < 1.0E-5D) {
            return;
        }

        Vec3 tenderMotion = this.getDeltaMovement();
        Vec3 leaderMotion = leader.getDeltaMovement();
        Vec3 consistReferenceMotion = this.getConsistReferenceMotion(leader, leaderMotion);
        boolean curveTransition = this.isOnSharpCurve() || isRollingStockOnSharpCurve(leader);
        boolean chainedFollower = leader instanceof SteamTender;
        boolean chainedCornerTransition = chainedFollower
                && this.isChainedCornerTransition((SteamTender) leader);

        if (chainedCornerTransition) {
            this.chainedCurveHandoffTicks = CHAINED_CURVE_HANDOFF_TICKS;
        } else if (chainedFollower && this.chainedCurveHandoffTicks > 0) {
            this.chainedCurveHandoffTicks--;
        } else if (!chainedFollower) {
            this.chainedCurveHandoffTicks = 0;
            this.chainedPathDirection = Vec3.ZERO;
        }

        /*
         * Step 7.2.1d: chained cars do not use leader/follower Euclidean spacing
         * while negotiating a corner, nor for the brief exit window immediately
         * afterward.  On a 90-degree rail the straight line between two cars cuts
         * across the inside of the curve and can point a follower in front of the
         * train.  Sample Minecraft's own minecart rail path with getPosOffs() and
         * only adjust speed along that local path tangent.
         */
        if (chainedFollower) {
            /*
             * Step 7.2.1f: every chained follower now stays rail-owned, not just
             * during a literal corner handoff.  This removes the last straight-
             * line correction that could pull cart #3 into cart #2 at crawl speed.
             * Distance changes only the follower's speed along its own rail path.
             */
            this.debugControllerPhase = "PRE";
            this.applyChainedRailPathSpeed(
                    leader, tenderMotion, consistReferenceMotion, distance);
                    this.applyImmediateLeaderSpacingSafety(leader);
            return;
        }

        /*
         * The proven two-vehicle locomotive/tender constraint keeps using the
         * tender's live motion tangent exactly as before.
         */
        double tenderHorizontalSpeed = Math.sqrt(
                tenderMotion.x * tenderMotion.x + tenderMotion.z * tenderMotion.z);
        double axisX;
        double axisZ;
        Vec3 chainedRailAxis = chainedFollower ? this.getCurrentRailHorizontalAxis() : null;
        if (chainedRailAxis != null) {
            axisX = chainedRailAxis.x;
            axisZ = chainedRailAxis.z;
        } else if (tenderHorizontalSpeed > 1.0E-4D) {
            axisX = tenderMotion.x / tenderHorizontalSpeed;
            axisZ = tenderMotion.z / tenderHorizontalSpeed;
        } else {
            /*
             * Step 7.3.2b: while reversing, a temporarily stalled first tender
             * must use the locomotive's live travel direction instead of its
             * model-facing yaw.  Otherwise the close-gap correction can point
             * into the locomotive just when the consist starts pushing.
             */
            double leaderHorizontalSpeed = Math.sqrt(
                    leaderMotion.x * leaderMotion.x + leaderMotion.z * leaderMotion.z);
            if (leaderHorizontalSpeed > 1.0E-4D) {
                axisX = leaderMotion.x / leaderHorizontalSpeed;
                axisZ = leaderMotion.z / leaderHorizontalSpeed;
            } else {
                double radians = Math.toRadians(this.getTrainFacingYaw());
                axisX = Math.sin(radians);
                axisZ = -Math.cos(radians);
            }
        }

        double toLeaderDot = offset.x * axisX + offset.z * axisZ;
        double towardLeaderSign = toLeaderDot >= 0.0D ? 1.0D : -1.0D;

        double minimumSpacing = curveTransition
                ? this.getPrimaryCurveCouplingMinDistance(leader)
                : this.getPrimaryCouplingMinDistance(leader);
        double maximumSpacing = curveTransition
                ? this.getPrimaryCurveCouplingMaxDistance(leader)
                : this.getPrimaryCouplingMaxDistance(leader);

        double spacingError = 0.0D;
        if (distance > maximumSpacing) {
            spacingError = distance - maximumSpacing;
        } else if (distance < minimumSpacing) {
            spacingError = distance - minimumSpacing;
        }
        double correction = Mth.clamp(
                spacingError * COUPLING_CORRECTION,
                -COUPLING_MAX_CORRECTION,
                COUPLING_MAX_CORRECTION);

        double currentAlongRail = tenderMotion.x * axisX + tenderMotion.z * axisZ;
        double leaderAlongRail = leaderMotion.x * axisX + leaderMotion.z * axisZ;
        double referenceAlongRail = consistReferenceMotion.x * axisX
                + consistReferenceMotion.z * axisZ;
        double referenceTrackSpeed = Math.max(leaderMotion.length(), consistReferenceMotion.length());

        /*
         * Step 7.3.2j - reverse primary curve direction ownership.
         *
         * The 7.3.2i recorder caught the first tender entering a south_east
         * curve at about 7.94 km/h while the locomotive was still on the
         * east_west leg. Projecting locomotive/reference motion onto the
         * tender's local curve axis produced the opposite sign and collapsed
         * the tender to about 0.84 km/h in one tick. During established
         * reverse travel on a curve transition, the first tender's own live
         * along-axis sign is authoritative.
         */
        SmallSteamLocomotive primaryCurveLead =
                CouplingManager.findLeadLocomotive(leader);
        /* Step 7.3.2k - established reverse primary direction ownership. */
        boolean reversePrimaryTravel =
                primaryCurveLead != null
                        && primaryCurveLead.isReverseConsistTravel();

        double driveSign;
        /*
         * Step 7.3.2l - reverse primary topology owns direction.
         *
         * At crawl speed the local rail axis can reverse representation from one
         * tick to the next. currentAlong therefore cannot be used as a stable
         * physical direction source. During established reverse travel the first
         * tender is being pushed, so the invariant is: move AWAY from the
         * locomotive. towardLeaderSign expresses the local-axis direction toward
         * the locomotive, so reverse push is its exact opposite.
         */
        if (reversePrimaryTravel && Math.abs(towardLeaderSign) > 0.5D) {
            driveSign = -towardLeaderSign;
        } else if (chainedFollower && Math.abs(currentAlongRail) > 0.002D) {
            // A rear car's own rail direction is authoritative.  The leader can
            // be on a different leg of a turn, so projecting its motion here can
            // legitimately have the opposite sign.
            driveSign = Math.signum(currentAlongRail);
        } else if (Math.abs(referenceAlongRail) > 0.01D) {
            driveSign = Math.signum(referenceAlongRail);
        } else if (Math.abs(leaderAlongRail) > 0.01D) {
            driveSign = Math.signum(leaderAlongRail);
        } else if (Math.abs(currentAlongRail) > 0.01D) {
            driveSign = Math.signum(currentAlongRail);
        } else {
            driveSign = towardLeaderSign;
        }
        double targetAlongRail = referenceTrackSpeed * driveSign;

        double newAlongRail = currentAlongRail * (1.0D - COUPLING_VELOCITY_BLEND)
                + targetAlongRail * COUPLING_VELOCITY_BLEND
                + towardLeaderSign * correction;

        RailShape currentShape = this.getCurrentRailShape();
        double cap = isSharpVanillaCurve(currentShape)
                ? COUPLED_CURVE_CATCHUP_SPEED
                : COUPLED_STRAIGHT_CATCHUP_SPEED;

        newAlongRail = Mth.clamp(newAlongRail, -cap, cap);

        this.logPrimaryControllerDecision(
                leader, curveTransition, distance,
                minimumSpacing, maximumSpacing,
                spacingError, correction,
                currentAlongRail, leaderAlongRail, referenceAlongRail,
                referenceTrackSpeed, driveSign, targetAlongRail,
                newAlongRail, cap,
                axisX, axisZ, towardLeaderSign);

        this.setDeltaMovement(axisX * newAlongRail, tenderMotion.y, axisZ * newAlongRail);
    }

    /**
     * Keeps a chained follower on Minecraft's own minecart path during a curve.
     * Direction comes from the follower's local rail tangent, never from a
     * straight-line vector to a leader that may already be on another leg of the
     * corner.  Speed changes are deliberately rate-limited so a low-speed cart
     * cannot be fired through the curve by one catch-up tick.
     */
    private void applyChainedRailPathSpeed(Entity leader, Vec3 motion,
                                           Vec3 consistReferenceMotion,
                                           double couplingDistance) {
        double referenceHorizontalSpeed = Math.sqrt(
                consistReferenceMotion.x * consistReferenceMotion.x
                        + consistReferenceMotion.z * consistReferenceMotion.z);

        Vec3 directedTangent = this.getDirectedRailPathTangent(
                leader, motion, consistReferenceMotion);
        if (directedTangent == null) {
            this.logChainedControllerDecision(
                    leader, "NO_TANGENT", false,
                    couplingDistance, Double.NaN, Double.NaN, Double.NaN,
                    referenceHorizontalSpeed, Math.sqrt(
                            motion.x * motion.x + motion.z * motion.z),
                    Double.NaN, Double.NaN, Double.NaN,
                    Vec3.ZERO);
            return;
        }

        double currentHorizontalSpeed = Math.sqrt(
                motion.x * motion.x + motion.z * motion.z);

        /*
         * The Euclidean distance between two cars on opposite legs of a vanilla
         * 90-degree curve is shorter than the true distance along the rails.
         * Keep the tight classic spacing on straights/slopes, but do not interpret
         * normal curved geometry as an overlap and stall the rear car.
         */
        boolean cornerHandoff = leader instanceof SteamTender leaderTender
                && (this.isChainedCornerTransition(leaderTender)
                || this.chainedCurveHandoffTicks > 0);

        double nearDistance = cornerHandoff
                ? this.getChainedCurveNearDistance(leader)
                : this.getChainedNearDistance(leader);
        double stopDistance = cornerHandoff
                ? this.getChainedCurveStopDistance(leader)
                : this.getChainedStopDistance(leader);
        double farDistance = cornerHandoff
                ? this.getChainedCurveFarDistance(leader)
                : this.getChainedFarDistance(leader);

        /*
         * When a consist is stationary, settle a newly connected rear tender to
         * the normal classic gap without teleporting it.  Motion is only along
         * the local rail tangent, so a backwards-placed or closely placed cart
         * cannot be fired diagonally across a corner.
         */
        if (referenceHorizontalSpeed <= CHAINED_CURVE_MIN_REFERENCE_SPEED) {
            if (!cornerHandoff && Math.abs(couplingDistance - nearDistance) > 0.04D) {
                Vec3 offset = leader.position().subtract(this.position());
                double towardLeaderDot = offset.x * directedTangent.x
                        + offset.z * directedTangent.z;
                double towardLeaderSign = towardLeaderDot >= 0.0D ? 1.0D : -1.0D;
                double settleSign = couplingDistance < nearDistance
                        ? -towardLeaderSign
                        : towardLeaderSign;
                double gapError = Math.abs(couplingDistance - nearDistance);
                double settleSpeed = Math.min(
                        CHAINED_STATIONARY_SETTLE_SPEED,
                        0.010D + gapError * 0.05D);
                this.logChainedControllerDecision(
                        leader, "STATIONARY_SETTLE", cornerHandoff,
                        couplingDistance, nearDistance, stopDistance, farDistance,
                        referenceHorizontalSpeed, currentHorizontalSpeed,
                        settleSpeed, settleSpeed, settleSpeed,
                        directedTangent.scale(settleSign));
                this.setDeltaMovement(
                        directedTangent.x * settleSign * settleSpeed,
                        motion.y,
                        directedTangent.z * settleSign * settleSpeed);
            } else if (currentHorizontalSpeed > 1.0E-4D) {
                this.logChainedControllerDecision(
                        leader, "STATIONARY_STOP", cornerHandoff,
                        couplingDistance, nearDistance, stopDistance, farDistance,
                        referenceHorizontalSpeed, currentHorizontalSpeed,
                        0.0D, 0.0D, 0.0D,
                        directedTangent);
                this.setDeltaMovement(0.0D, motion.y, 0.0D);
            } else {
                this.logChainedControllerDecision(
                        leader, "STATIONARY_HOLD", cornerHandoff,
                        couplingDistance, nearDistance, stopDistance, farDistance,
                        referenceHorizontalSpeed, currentHorizontalSpeed,
                        0.0D, 0.0D, 0.0D,
                        directedTangent);
            }
            return;
        }

        /*
         * Follow the lead locomotive's actual consist speed, then use only the
         * segment gap to trim magnitude.  Direction remains rail-owned.  The
         * stronger bounded catch-up reserve is specifically for full-power and
         * downhill running; the locomotive-side tail governor in Step 7.2.1f
         * prevents the leader from running away while this rear car closes.
         */
        double targetSpeed = referenceHorizontalSpeed + CHAINED_CURVE_SPEED_MARGIN;
        double targetBeforeGap = targetSpeed;
        boolean reverseDrive = this.isConsistReverseDriveRequested(leader);
        String controllerAction = "TRACK";

        if (couplingDistance > farDistance) {
            controllerAction = reverseDrive ? "STRETCHED_REVERSE" : "STRETCHED_FORWARD";
            double correctionCap = reverseDrive
                    ? CHAINED_REVERSE_RELATIVE_SPEED_MAX
                    : CHAINED_HANDOFF_MAX_SPEED_BOOST;
            double extra = Math.min(
                    correctionCap,
                    (couplingDistance - farDistance)
                            * CHAINED_HANDOFF_GAP_SPEED_GAIN);
            /*
             * Forward: follower is behind, so a stretched segment must speed up.
             * Reverse: follower is being pushed and is ahead in travel order, so
             * a stretched segment must slow down and let its leader catch up.
             */
            targetSpeed += reverseDrive ? -extra : extra;
        }

        /*
         * Forward compression is corrected by slowing the follower.  In reverse
         * that is exactly backwards: slowing a pushed follower lets its leader
         * drive farther into it.  A compressed reverse segment therefore gets a
         * bounded speed reserve away from the leader instead.
         */
        if (couplingDistance < nearDistance) {
            controllerAction = reverseDrive ? "COMPRESSED_REVERSE" : "COMPRESSED_FORWARD";
            double spacingScale = Mth.clamp(
                    (couplingDistance - stopDistance)
                            / (nearDistance - stopDistance),
                    0.0D, 1.0D);
            if (reverseDrive) {
                double compressionBoost = Math.min(
                        CHAINED_REVERSE_RELATIVE_SPEED_MAX,
                        (nearDistance - couplingDistance)
                                * CHAINED_HANDOFF_GAP_SPEED_GAIN);
                targetSpeed += compressionBoost;
            } else {
                targetSpeed *= spacingScale;
            }
        }

        double targetAfterGap = targetSpeed;
        double maxCatchupSpeed = this.getChainedMaxCatchupSpeed(leader);
        targetSpeed = Mth.clamp(
                targetSpeed,
                0.0D,
                maxCatchupSpeed);

        double newSpeed;
        if (currentHorizontalSpeed < targetSpeed) {
            newSpeed = Math.min(
                    targetSpeed,
                    currentHorizontalSpeed + CHAINED_CURVE_SPEED_CHANGE_PER_TICK);
        } else {
            newSpeed = Math.max(
                    targetSpeed,
                    currentHorizontalSpeed - CHAINED_CURVE_SPEED_CHANGE_PER_TICK);
        }

        if (currentHorizontalSpeed <= 1.0E-4D) {
            newSpeed = Math.min(targetSpeed, CHAINED_CURVE_MAX_CRAWL_SPEED);
        }

        this.logChainedControllerDecision(
                leader, controllerAction, cornerHandoff,
                couplingDistance, nearDistance, stopDistance, farDistance,
                referenceHorizontalSpeed, currentHorizontalSpeed,
                targetBeforeGap, targetAfterGap, targetSpeed,
                directedTangent, newSpeed, maxCatchupSpeed, reverseDrive);

        this.setDeltaMovement(
                directedTangent.x * newSpeed,
                motion.y,
                directedTangent.z * newSpeed);
    }

    /**
     * Returns the current rail-path tangent with a stable travel direction.  The
     * undirected tangent is sampled by AbstractMinecart.getPosOffs(), which follows
     * the real vanilla rail path through a 90-degree curve instead of approximating
     * the curved block as one fixed diagonal vector.
     */
    @Nullable
    private Vec3 getDirectedRailPathTangent(Entity leader, Vec3 motion,
                                             Vec3 consistReferenceMotion) {
        Vec3 tangent = this.getCurrentRailHorizontalAxis();
        this.debugDirectionSource = "none";
        this.debugReferenceDot = Double.NaN;
        this.debugLeaderDot = Double.NaN;
        this.debugMotionDot = Double.NaN;
        this.debugMinimumProjection = Double.NaN;
        if (tangent == null) {
            return null;
        }

        /*
         * Step 7.2.1l: NEVER let a chained follower's own velocity decide the
         * train's travel direction while the consist is moving.  The telemetry
         * caught the exact failure: cart #3 had leaderAlong=-1.864 but
         * motionAlong=+0.083, so its speed controller accelerated it away from
         * cart #2 until it ran around the loop and met the locomotive from ahead.
         *
         * Use the lead locomotive/reference motion first.  On the brief part of
         * a 90-degree turn where that projection is nearly perpendicular, retain
         * the previous directed rail tangent for continuity.  The immediate
         * leader and follower motion are only fallbacks.
         */
        double directionDot = 0.0D;
        boolean directionKnown = false;

        /*
         * Step 7.3.2e: coupling topology owns travel direction.
         *
         * The movement flight recorder caught a rear vehicle selecting the lead
         * locomotive's projection while that locomotive was already on a
         * different leg of a hill/curve. The projection was numerically strong,
         * but it pointed away from the immediate leader.
         *
         * Use the follower's LOCAL rail tangent plus the IMMEDIATE coupling
         * topology first. Forward followers move toward their leader; reverse-
         * pushed followers move away from it. If that projection is nearly
         * perpendicular, the existing continuity/reference fallbacks still run.
         */
        Vec3 topologyOffset = leader.position().subtract(this.position());
        double topologyDot = topologyOffset.x * tangent.x
                + topologyOffset.z * tangent.z;
        double topologyHorizontalDistance = Math.sqrt(
                topologyOffset.x * topologyOffset.x
                        + topologyOffset.z * topologyOffset.z);
        double topologyProjectionThreshold = Math.max(
                0.05D,
                Math.min(0.20D, topologyHorizontalDistance * 0.05D));
        if (Math.abs(topologyDot) > topologyProjectionThreshold) {
            directionDot = this.isConsistReverseDriveRequested(leader)
                    ? -topologyDot
                    : topologyDot;
            directionKnown = true;
        }

        double referenceHorizontalSpeed = Math.sqrt(
                consistReferenceMotion.x * consistReferenceMotion.x
                        + consistReferenceMotion.z * consistReferenceMotion.z);
        double referenceDot = consistReferenceMotion.x * tangent.x
                + consistReferenceMotion.z * tangent.z;
        double projectionRatio = Mth.clamp(
                this.getChainedDirectionProjectionRatio(leader),
                0.0D, 1.0D);
        double minimumReferenceProjection = Math.max(
                0.002D,
                referenceHorizontalSpeed * projectionRatio);
        this.debugReferenceDot = referenceDot;
        this.debugMinimumProjection = minimumReferenceProjection;
        if (!directionKnown
                && referenceHorizontalSpeed > 1.0E-4D
                && Math.abs(referenceDot) > minimumReferenceProjection) {
            directionDot = referenceDot;
            directionKnown = true;
            this.debugDirectionSource = "REFERENCE";
        }

        if (!directionKnown
                && this.chainedPathDirection.x * this.chainedPathDirection.x
                + this.chainedPathDirection.z * this.chainedPathDirection.z > 1.0E-8D) {
            double continuityDot = this.chainedPathDirection.x * tangent.x
                    + this.chainedPathDirection.z * tangent.z;
            if (Math.abs(continuityDot) > 0.05D) {
                directionDot = continuityDot;
                directionKnown = true;
                this.debugDirectionSource = "CONTINUITY";
            }
        }

        if (!directionKnown) {
            Vec3 leaderMotion = leader.getDeltaMovement();
            double leaderHorizontalSpeed = Math.sqrt(
                    leaderMotion.x * leaderMotion.x + leaderMotion.z * leaderMotion.z);
            double leaderDot = leaderMotion.x * tangent.x + leaderMotion.z * tangent.z;
            this.debugLeaderDot = leaderDot;
            double minimumLeaderProjection = Math.max(
                    0.002D,
                    leaderHorizontalSpeed * projectionRatio);
            if (leaderHorizontalSpeed > 1.0E-4D
                    && Math.abs(leaderDot) > minimumLeaderProjection) {
                directionDot = leaderDot;
                directionKnown = true;
                this.debugDirectionSource = "LEADER";
            }
        }

        if (!directionKnown) {
            double horizontalSpeed = Math.sqrt(motion.x * motion.x + motion.z * motion.z);
            double motionDot = motion.x * tangent.x + motion.z * tangent.z;
            this.debugMotionDot = motionDot;
            if (horizontalSpeed > 1.0E-4D && Math.abs(motionDot) > 0.002D) {
                directionDot = motionDot;
                directionKnown = true;
                this.debugDirectionSource = "FOLLOWER";
            }
        }

        if (!directionKnown) {
            // Stationary fallback only.  Spacing-settle code separately decides
            // whether to move toward or away from the leader, so model polarity
            // cannot launch a moving consist in the wrong direction.
            Vec3 toLeader = leader.position().subtract(this.position());
            directionDot = toLeader.x * tangent.x + toLeader.z * tangent.z;
            if (Math.abs(directionDot) <= 1.0E-5D) {
                directionDot = 1.0D;
            }
            this.debugDirectionSource = "STATIONARY_TO_LEADER";
        }

        if (directionDot < 0.0D) {
            tangent = tangent.scale(-1.0D);
        }

        this.chainedPathDirection = tangent;
        return tangent;
    }



