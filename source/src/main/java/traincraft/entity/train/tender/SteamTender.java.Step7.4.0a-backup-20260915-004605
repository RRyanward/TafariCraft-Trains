    @Override
    protected double getMaxSpeed() {
        RailShape shape = this.getCurrentRailShape();
        if (this.hasCoupledRollingStock()) {
            return isSharpVanillaCurve(shape)
                    ? COUPLED_CURVE_CATCHUP_SPEED
                    : COUPLED_STRAIGHT_CATCHUP_SPEED;
