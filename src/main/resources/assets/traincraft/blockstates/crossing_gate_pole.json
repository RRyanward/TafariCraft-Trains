{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "traincraft:block/modular_crossing/crossing_gate_pole"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "traincraft:block/modular_crossing/crossing_gate_pole",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "traincraft:block/modular_crossing/crossing_gate_pole",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "traincraft:block/modular_crossing/crossing_gate_pole",
        "y": 270
      }
    }
  ]
}
